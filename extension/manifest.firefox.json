{
  "manifest_version": 3,
  "name": "Lecteur QR → SoWeSign",
  "version": "1.1.1",
  "description": "Remplit dans SoWeSign le code scanné par le Lecteur QR et prévient quand la session tombe. Ne valide jamais, ne se connecte jamais.",
  "permissions": ["storage", "notifications"],
  "icons": { "192": "icon.png" },
  "action": { "default_title": "Lecteur QR → SoWeSign", "default_icon": { "192": "icon.png" } },
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://app.sowesign.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "lecteur-qr@aurelien-labro.github.io" }
  }
}
